# Copy this file to .env.local for local development, and set the same two
# values as Environment Variables in the Vercel project (Project Settings ->
# Environment Variables) for the deployed site. Both are server-only -- never
# prefix them with NEXT_PUBLIC_.

# Supabase project URL (Project Settings -> Data API -> Project URL)
SUPABASE_URL=

# Supabase SERVICE ROLE key -- not the anon key (Project Settings -> Data API
# -> Project API keys -> service_role). This key bypasses Row Level Security,
# so it must only ever be used server-side (as it is here, inside the API
# routes) and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
