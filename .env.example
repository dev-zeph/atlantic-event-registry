# Copy this file to .env.local for local development, and set the same two
# values as Environment Variables in the Vercel project (Project Settings ->
# Environment Variables) for the deployed site.

# Supabase project URL (Project Settings -> Data API -> Project URL)
SUPABASE_URL=

# Supabase publishable key (Project Settings -> Data API -> API Keys ->
# Publishable key, starts with sb_publishable_). Row Level Security is off on
# the event_dates table for this project (see supabase/schema.sql) -- this is
# a deliberately open setup for a short-lived demo, not a pattern to reuse for
# anything longer-lived or with sensitive data.
SUPABASE_PUBLISHABLE_KEY=
